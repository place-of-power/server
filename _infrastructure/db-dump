#!/bin/bash

set -e

cd "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

FILE="${1:-_dumps/dump.sql}"
TMP="$FILE.tmp"

mkdir -p "$(dirname "$FILE")"

# дамп полный (схема + данные): применённый поверх сидов, он заменяет их содержимым
# дампа — дамп всегда главный источник свежих данных
# версии миграций не включаем: схема у них уже есть в базе, дамп их не трогает
# временный файл, чтобы не затирать прошлый удачный дамп при сбое pg_dump
docker compose exec -T postgres sh -c 'pg_dump --clean --if-exists --exclude-table=doctrine_migration_versions -U "$POSTGRES_USER" "$POSTGRES_DB"' > "$TMP"

mv "$TMP" "$FILE"

echo "Dump: $FILE"
