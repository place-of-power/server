#!/bin/bash

set -e

cd "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

FILE="${1:-_dumps/dump.sql}"

if [[ ! -f "$FILE" ]]; then
    echo "Дамп не найден: $FILE" >&2
    exit 1
fi

# -1: одна транзакция, чтобы при ошибке не остаться без части таблиц
docker compose exec -T postgres sh -c 'psql -1 -v ON_ERROR_STOP=1 -U "$POSTGRES_USER" "$POSTGRES_DB"' < "$FILE"

echo "Restored: $FILE"
