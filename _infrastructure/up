#!/bin/bash

set -e

# Определяем директорию _infrastructure (чтобы скрипт работал из любого места)
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cd "$SCRIPT_DIR"

#1. Создаём .env файлы
source "$SCRIPT_DIR/_scripts/init-env.sh"

#2. Собираем и поднимаем контейнеры (php-base соберётся первым, как зависимость)
docker compose up -d --build

#3. Устанавливаем зависимости
source "$SCRIPT_DIR/composer" i

#4. Сбрасываем кеш фреймворка
source "$SCRIPT_DIR/console" cache:clear